# RP2040-Zero + ESP32-S3 SuperMini stack (hardware/ESP32.md): the cable talks SPI.
# idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.zero-stack" build
CONFIG_DCL_LINK_SPI=y
CONFIG_DCL_LSPI_MOSI=6
CONFIG_DCL_LSPI_MISO=3
CONFIG_DCL_LSPI_SCLK=5
CONFIG_DCL_LSPI_CS=4
CONFIG_DCL_LSPI_HS=2
CONFIG_DCL_LSPI_DR=7
# W5500 module on the ESP32's native SPI pins (full-speed IO MUX), GPIO9-13 on the right-hand column:
# SCLK 12, MOSI 11, MISO 13, CS 10, INT 9. In the stack they sit over the Zero's GP15 and GP26-29
# (SD card, sense wire): never joined. The link's DR line is on GPIO7 so GPIO2-7 are one straight run.
CONFIG_DCL_W5500_SCLK=12
CONFIG_DCL_W5500_MOSI=11
CONFIG_DCL_W5500_MISO=13
CONFIG_DCL_W5500_CS=10
CONFIG_DCL_W5500_INT=9
