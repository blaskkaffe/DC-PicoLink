# RP2040-Zero + ESP32-S3 SuperMini stack (hardware/ESP32.md): the cable talks SPI.
# idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.zero-stack" build
CONFIG_DCL_LINK_SPI=y
CONFIG_DCL_LSPI_MOSI=6
CONFIG_DCL_LSPI_MISO=3
CONFIG_DCL_LSPI_SCLK=5
CONFIG_DCL_LSPI_CS=4
CONFIG_DCL_LSPI_HS=2
CONFIG_DCL_LSPI_DR=7
# W5500 module on GPIO9-13, all on the SuperMini's right-hand pin column beside 3V3/GND (the
# stripboard layout, hardware/STRIPBOARD.md). The link's DR line moved to GPIO7 so GPIO1-7 are
# one straight run GP2..GP8 <-> GPIO1..GPIO7 in the stack (GPIO1 unused).
CONFIG_DCL_W5500_MOSI=13
CONFIG_DCL_W5500_SCLK=12
CONFIG_DCL_W5500_CS=11
CONFIG_DCL_W5500_INT=10
CONFIG_DCL_W5500_MISO=9
