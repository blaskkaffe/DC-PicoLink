CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# console on the board's own USB (USB-Serial-JTAG); UART1 is the cable link
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
# sockets: web page (4) + DreamPi settings (2) + DNS (4) + VPN + DCNow!/downloads + UPnP + tests; 16 ran out
CONFIG_LWIP_MAX_SOCKETS=24
# E-3: PPP server for the Dreamcast, NAT out through Wi-Fi
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_LCP_ECHOINTERVAL=0
CONFIG_LWIP_IPV4_NAPT_PORTMAP=y
# HTTPS to dcnow-2016.appspot.com and dreamcast.online
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
# E-7: OpenVPN client: TLS buffers are freed after the handshake
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# RAM is tight (no PSRAM): the serial speeds here need little Wi-Fi buffering
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# secure connections: we only send small requests, so a small send buffer (saves about 12 KB per connection)
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# RAM (no PSRAM): on the S3, code kept in IRAM comes out of the same RAM as the heap. The game
# traffic is small, so the Wi-Fi fast paths stay in flash, and fewer fixed receive buffers.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
