#!/bin/bash
# dcusb0-vpn - give the W5500 Dreamcast (dcusb0) its own Dreamcast Live VPN
# address, the way DreamPi does for a modem Dreamcast.
#
# DreamPi with the VPN up: tun0 has the Pi's VPN address T, and a modem
# Dreamcast gets T+1 as its own address, so servers and other players reach it
# directly on every port. Without this script, dcusb0 is masqueraded behind T
# and DreamPi's firewall drops new incoming connections to T: hosting, peers
# joining (AFO, Worms World Party, Quake 3, Unreal Tournament) can't reach it.
#
# Here: T+1 is mapped 1:1 to the W5500 Dreamcast's address on dcusb0 (all
# ports, both directions), and TCP MSS is clamped to the VPN's smaller MTU.
# The script follows changes by itself every few seconds: the VPN coming up or
# reconnecting with a new address, the Dreamcast getting a new DHCP lease (each
# game may use its own MAC). While DreamPi has a modem Dreamcast online (ppp0),
# T+1 is that one's, and the mapping is taken down.
#
# VPN_ROUTE (in /etc/dcusb0.conf) says which of the Dreamcast's traffic goes
# through the VPN: "all" (default: everything, if the VPN server forwards to the
# Internet; checked with a ping through tun0, else only VPN addresses), a list of
# addresses/networks ("20.102.63.253 192.246.40.56/32"), or "none" (only 10.200.x.x).
# It is policy routing for the Dreamcast's address only: the Pi itself and DreamPi
# are not touched, and when the VPN is down the Dreamcast falls back to the LAN.
#
# LAN_ALIAS (default auto): like DreamPi does for a modem Dreamcast, the W5500 Dreamcast
# also gets its own address on the Pi's LAN (DreamPi's choice, read from the "ms-dns" line
# DreamPi writes to /etc/ppp/options, e.g. 192.168.1.98): an alias on the Pi's network card,
# Internet traffic leaves with it (SNAT), and anything sent to it is passed to the Dreamcast
# (DNAT), so the router's UPnP forwards DreamPi made for that address work too. TTL is set to
# 64 on the Dreamcast's packets (DreamPi does the same for ppp0). "none" = old behaviour.
# While a modem/serial Dreamcast is online the alias is DreamPi's; it is left alone.
#
# Run by dcusb0-vpn.service. "dcusb0-vpn stop" removes everything.
set -u
[ -f /etc/dcusb0.conf ] && . /etc/dcusb0.conf
VPN_IF=${VPN_IF:-tun0}
VPN_MAP=${VPN_MAP:-yes}
VPN_ROUTE=${VPN_ROUTE:-all}
LAN_ALIAS=${LAN_ALIAS:-auto}
VPN_PROBE=${VPN_PROBE:-1.1.1.1}         # "all" is used only if this answers a ping through the VPN
RT_TABLE=217
RT_PRIO=1000
IF=dcusb0
LEASES=/run/dcusb0.leases

log() { echo "dcusb0-vpn: $*"; }

chains() {      # create our chains and hook them in once
    iptables -t nat -N DCUSB0_PRE 2>/dev/null
    iptables -t nat -N DCUSB0_POST 2>/dev/null
    iptables -N DCUSB0_FWD 2>/dev/null
    iptables -t mangle -N DCUSB0_MSS 2>/dev/null
    iptables -t nat -C PREROUTING -j DCUSB0_PRE 2>/dev/null || iptables -t nat -I PREROUTING 1 -j DCUSB0_PRE
    iptables -t nat -C POSTROUTING -j DCUSB0_POST 2>/dev/null || iptables -t nat -I POSTROUTING 1 -j DCUSB0_POST
    iptables -C FORWARD -j DCUSB0_FWD 2>/dev/null || iptables -I FORWARD 1 -j DCUSB0_FWD
    # mangle POSTROUTING, not FORWARD: DreamPi puts RETURN rules for tun0 at the top of mangle FORWARD
    iptables -t mangle -C POSTROUTING -j DCUSB0_MSS 2>/dev/null || iptables -t mangle -I POSTROUTING 1 -j DCUSB0_MSS
    # DreamPi's packet helpers (dcgamespy, dc2k2, dcvoip) tell the Dreamcast's direction by "came in
    # on ppp0". Packets from the W5500 Dreamcast come in on dcusb0: dcgamespy's SYN+PSH fix is fed
    # from here too (its handler does not look at the interface); dc2k2 and dcvoip would take them
    # for packets *to* the Dreamcast and write the wrong address into them, so they skip them.
    iptables -t mangle -N DCUSB0_HELP 2>/dev/null
    iptables -t mangle -F DCUSB0_HELP
    iptables -t mangle -A DCUSB0_HELP -i "$IF" -p tcp --tcp-flags ALL SYN,PSH -j NFQUEUE --queue-num 1 --queue-bypass
    iptables -t mangle -A DCUSB0_HELP -i "$IF" -p tcp --dport 5011 -j ACCEPT
    iptables -t mangle -A DCUSB0_HELP -i "$IF" -p udp --sport 1285 --dport 1285 -j ACCEPT
    iptables -t mangle -C PREROUTING -j DCUSB0_HELP 2>/dev/null || iptables -t mangle -I PREROUTING 1 -j DCUSB0_HELP
    # dcdaytona (UDP 12079 <-> 12079, mangle FORWARD): the same direction test, so skip it too
    iptables -t mangle -N DCUSB0_HELPF 2>/dev/null
    iptables -t mangle -F DCUSB0_HELPF
    iptables -t mangle -A DCUSB0_HELPF -i "$IF" -p udp --sport 12079 --dport 12079 -j ACCEPT
    iptables -t mangle -C FORWARD -j DCUSB0_HELPF 2>/dev/null || iptables -t mangle -I FORWARD 1 -j DCUSB0_HELPF
}

flush() {
    iptables -t nat -F DCUSB0_PRE 2>/dev/null
    iptables -t nat -F DCUSB0_POST 2>/dev/null
    iptables -F DCUSB0_FWD 2>/dev/null
    iptables -t mangle -F DCUSB0_MSS 2>/dev/null
}

route_off() {
    while ip rule del priority $RT_PRIO 2>/dev/null; do :; done
    ip route flush table $RT_TABLE 2>/dev/null
}

route_on() {    # $1 = the Dreamcast's address; returns 1 if nothing is routed through the VPN
    route_off
    case "$VPN_ROUTE" in
    none) return 0 ;;
    all)
        if ! ping -c 2 -W 2 -I "$VPN_IF" "$VPN_PROBE" >/dev/null 2>&1; then
            log "VPN_ROUTE=all: $VPN_PROBE does not answer through $VPN_IF (the VPN server may not forward to the Internet): only VPN addresses go through it; trying again every minute"
            return 1
        fi
        ip route replace default dev "$VPN_IF" table $RT_TABLE || return 1
        ip rule add from "$1" lookup $RT_TABLE priority $RT_PRIO || return 1
        log "all Internet traffic from the Dreamcast now goes through $VPN_IF" ;;
    *)
        ip route replace default dev "$VPN_IF" table $RT_TABLE || return 1
        for n in $VPN_ROUTE; do ip rule add from "$1" to "$n" lookup $RT_TABLE priority $RT_PRIO; done
        log "traffic from the Dreamcast to $VPN_ROUTE goes through $VPN_IF" ;;
    esac
    # replies come in on tun0 from addresses the main table reaches through the LAN
    sysctl -qw "net.ipv4.conf.$VPN_IF.rp_filter=2" 2>/dev/null
    return 0
}

ALIAS_MINE=/run/dcusb0-vpn.alias       # the alias address we added (not DreamPi)

lan_alias() {   # the address DreamPi gives the Dreamcast on the LAN
    case "$LAN_ALIAS" in
    none|"") return ;;
    auto) awk '$1 == "ms-dns" {print $2; exit}' /etc/ppp/options 2>/dev/null ;;
    *) echo "$LAN_ALIAS" ;;
    esac
}
lan_if() { ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i+1); exit}}'; }

alias_off() {   # remove our alias, never DreamPi's (a modem/serial Dreamcast may be online)
    [ -f "$ALIAS_MINE" ] || return 0
    set -- $(cat "$ALIAS_MINE"); rm -f "$ALIAS_MINE"
    ip link show ppp0 >/dev/null 2>&1 && return 0
    ip addr del "$1/32" dev "$2" 2>/dev/null && log "LAN address $1 removed"
}

alias_on() {    # $1 = alias address, $2 = interface
    ip -4 -o addr show dev "$2" | grep -q " $1/" && return 0
    ip addr add "$1/32" dev "$2" label "$2:1" || return 1
    echo "$1 $2" > "$ALIAS_MINE"
}

remove() {
    alias_off
    route_off
    flush
    iptables -t nat -D PREROUTING -j DCUSB0_PRE 2>/dev/null
    iptables -t nat -D POSTROUTING -j DCUSB0_POST 2>/dev/null
    iptables -D FORWARD -j DCUSB0_FWD 2>/dev/null
    iptables -t mangle -D POSTROUTING -j DCUSB0_MSS 2>/dev/null
    iptables -t nat -X DCUSB0_PRE 2>/dev/null
    iptables -t nat -X DCUSB0_POST 2>/dev/null
    iptables -X DCUSB0_FWD 2>/dev/null
    iptables -t mangle -X DCUSB0_MSS 2>/dev/null
    iptables -t mangle -D PREROUTING -j DCUSB0_HELP 2>/dev/null
    iptables -t mangle -F DCUSB0_HELP 2>/dev/null
    iptables -t mangle -X DCUSB0_HELP 2>/dev/null
    iptables -t mangle -D FORWARD -j DCUSB0_HELPF 2>/dev/null
    iptables -t mangle -F DCUSB0_HELPF 2>/dev/null
    iptables -t mangle -X DCUSB0_HELPF 2>/dev/null
}

if [ "${1:-run}" = stop ]; then remove; exit 0; fi
command -v iptables >/dev/null 2>&1 || { log "iptables not found, nothing to do"; exit 0; }
[ "$VPN_MAP" = yes ] || { log "VPN_MAP=$VPN_MAP in /etc/dcusb0.conf: not mapping"; remove; exec sleep infinity; }

addr_of() { ip -4 -o addr show dev "$1" 2>/dev/null | awk '{split($4, a, "/"); print a[1]; exit}'; }

plus1() {       # a.b.c.d + 1
    local IFS=.; set -- $1
    local n=$(( ($1 << 24 | $2 << 16 | $3 << 8 | $4) + 1 ))
    echo "$(( n >> 24 & 255 )).$(( n >> 16 & 255 )).$(( n >> 8 & 255 )).$(( n & 255 ))"
}

dc_addr() {     # the Dreamcast on dcusb0: newest DHCP lease, else a neighbour (set by hand)
    local ip
    ip=$(sort -n -r "$LEASES" 2>/dev/null | awk 'NR == 1 {print $3}')
    [ -n "$ip" ] || ip=$(ip -4 neigh show dev "$IF" 2>/dev/null | awk '$0 !~ /FAILED|INCOMPLETE/ {print $1; exit}')
    echo "$ip"
}

state=""; rt_failed=0; loops=0
chains
while :; do
    loops=$((loops + 1))
    t=$(addr_of "$VPN_IF"); dc=$(dc_addr); want=""
    if [ -n "$t" ] && [ -n "$dc" ]; then
        if ip link show ppp0 >/dev/null 2>&1; then want="ppp0"; else want="$(plus1 "$t") $dc"; fi
    fi
    if [ "$want" != "$state" ]; then
        flush
        case "$want" in
        "") log "no mapping (VPN $VPN_IF: ${t:-down}, Dreamcast on $IF: ${dc:-none yet})" ;;
        ppp0) log "a modem Dreamcast is online (ppp0): VPN address $(plus1 "$t") is its, no mapping" ;;
        *)
            set -- $want; v=$1; d=$2
            iptables -t nat -A DCUSB0_PRE -i "$VPN_IF" -d "$v" -j DNAT --to-destination "$d"
            iptables -t nat -A DCUSB0_POST -o "$VPN_IF" -s "$d" -j SNAT --to-source "$v"
            iptables -A DCUSB0_FWD -i "$VPN_IF" -o "$IF" -d "$d" -j ACCEPT
            iptables -A DCUSB0_FWD -i "$IF" -o "$VPN_IF" -s "$d" -j ACCEPT
            iptables -t mangle -A DCUSB0_MSS -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
            iptables -t mangle -A DCUSB0_MSS -o "$IF" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
            log "Dreamcast $d on $IF = VPN address $v (all ports, both ways; $VPN_IF is $t)"
            # its own LAN address, as DreamPi gives a modem Dreamcast
            la=$(lan_alias); li=$(lan_if)
            if [ -n "$la" ] && [ -n "$li" ] && alias_on "$la" "$li"; then
                iptables -t nat -A DCUSB0_POST ! -o "$VPN_IF" -s "$d" -j SNAT --to-source "$la"
                iptables -t nat -A DCUSB0_PRE -i "$li" -d "$la" -j DNAT --to-destination "$d"
                iptables -A DCUSB0_FWD -i "$li" -o "$IF" -d "$d" -j ACCEPT
                log "Dreamcast $d on $IF = LAN address $la on $li (Internet traffic and the router's forwards to it)"
            elif [ -n "$la" ]; then
                log "could not add LAN address $la on ${li:-?}: Internet traffic uses the Pi's address"
            fi
            iptables -t mangle -A DCUSB0_MSS -s "$d" -j TTL --ttl-set 64 2>/dev/null
            route_on "$d" && rt_failed=0 || rt_failed=1
            # flows started before the mapping/route keep their old path and NAT until they time out
            if command -v conntrack >/dev/null 2>&1; then
                conntrack -D -s "$d" >/dev/null 2>&1
                [ -n "$la" ] && conntrack -D -d "$la" >/dev/null 2>&1
                conntrack -D -d "$v" >/dev/null 2>&1
            else
                log "conntrack is not installed: connections made before this change keep their old path until they time out (sudo apt-get install conntrack)"
            fi ;;
        esac
        if [ -z "$want" ] || [ "$want" = ppp0 ]; then route_off; alias_off; rt_failed=0; fi
        state=$want
    elif [ "$rt_failed" = 1 ] && [ $((loops % 12)) = 0 ]; then
        set -- $want; route_on "$2" && rt_failed=0 || rt_failed=1
    fi
    sleep 5
done
