[Unit]
Description=Dreamcast modem in the browser: page and PPP/DCNet relay (DC-PicoLink)
After=network.target
# The modem is used by Chrome's Web Serial, not by dc-modemd
Conflicts=dc-modemd.service dc-cabled.service

[Service]
ExecStart=/usr/bin/env python3 /usr/local/sbin/dc-modemd --relay $DC_MODEMD_ARGS
EnvironmentFile=-/etc/dc-modemd.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
